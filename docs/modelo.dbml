// Modelo editable en dbdiagram.io; moneda actual e histórica son independientes.
Table moneda {
  currency_id int [pk, increment]
  currency_name varchar(60) [not null, unique]
  currency_symbol varchar(10) [not null]
  currency_code char(3) [not null, unique]
}
Table usuario {
  user_id int [pk, increment]
  nombre varchar(100) [not null]
  correo_electronico varchar(254) [not null, unique]
  contrasena varchar(255) [not null, note: 'Hash de contraseña']
  saldo decimal(15,2) [not null, default: 0]
  currency_id int [not null]
  fecha_creacion timestamp [not null]
}
Table transaccion {
  transaction_id bigint [pk, increment]
  sender_user_id int [not null]
  receiver_user_id int [not null]
  currency_id int [not null]
  importe decimal(15,2) [not null]
  transaction_date datetime [not null]
  indexes {
    (sender_user_id, transaction_date)
    (receiver_user_id, transaction_date)
  }
}
Ref: usuario.currency_id > moneda.currency_id
Ref: transaccion.sender_user_id > usuario.user_id
Ref: transaccion.receiver_user_id > usuario.user_id
Ref: transaccion.currency_id > moneda.currency_id
